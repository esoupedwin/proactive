# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used by the cron route (server-side). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...
# Model used for web search + extraction (needs web_search tool support)
OPENAI_SEARCH_MODEL=gpt-5-mini
# Model used for report synthesis + memory updates
OPENAI_REPORT_MODEL=gpt-5

# OpenRouter (openrouter.ai/keys) — cheaper non-OpenAI models for secondary
# features. Existing features stay on OpenAI; only what names a model below
# goes through OpenRouter.
OPENROUTER_API_KEY=
# Model for the extracts "Summarize last 3 days" button. Any OpenRouter chat
# model id works — see openrouter.ai/models for ids and prices.
OPENROUTER_SUMMARY_MODEL=deepseek/deepseek-v4-flash

# Exa semantic search — the Info Tracker's exa_search tool (dashboard.exa.ai).
# Without it the tracker falls back to hosted web search only.
EXA_API_KEY=

# Related-news search (optional — powers the "Related news" popup).
# EXA_API_KEY is used first if set; otherwise Brave, then SerpApi.
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# Shared secret protecting /api/cron. Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Base URL of the deployed app (used for OAuth redirects locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
