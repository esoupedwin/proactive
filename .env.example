# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used by the cron route (server-side). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Platform keys
OPENAI_API_KEY=sk-...
# OpenRouter (openrouter.ai/keys) — needed when any tier below runs on it.
OPENROUTER_API_KEY=

# Model tiers — each is `platform:model` (platform: openai | openrouter; the
# split is on the FIRST colon, so OpenRouter suffixes like :online work).
#
# judgment  — verdicts & analysis: the Reporter, Analyst, stance updates.
# search    — retrieval & extraction with hosted web search: the Tracker,
#             Mentor, Sentiment, baselines, Tell-me-more. OpenAI only
#             (the hosted web_search tool exists nowhere else).
# utility   — plain text work: extract summaries and future bulk features.
# embedding — vector search over extracts. OpenAI only.
TIER_JUDGMENT=openai:gpt-5
TIER_SEARCH=openai:gpt-5-mini
TIER_UTILITY=openrouter:deepseek/deepseek-v4-flash
TIER_EMBEDDING=openai:text-embedding-3-small
# Legacy variables (OPENAI_REPORT_MODEL, OPENAI_SEARCH_MODEL,
# OPENROUTER_SUMMARY_MODEL, OPENAI_EMBEDDING_MODEL) still apply when a
# TIER_* line is unset.

# Exa semantic search — the Info Tracker's exa_search tool (dashboard.exa.ai).
# Without it the tracker falls back to hosted web search only.
EXA_API_KEY=

# Related-news search (optional — powers the "Related news" popup).
# EXA_API_KEY is used first if set; otherwise Brave, then SerpApi.
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# Shared secret protecting /api/cron. Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Base URL of the deployed app (used for OAuth redirects locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
