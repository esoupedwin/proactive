# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used by the cron route (server-side). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...
# Model used for web search + extraction (needs web_search tool support)
OPENAI_SEARCH_MODEL=gpt-5-mini
# Model used for report synthesis + memory updates
OPENAI_REPORT_MODEL=gpt-5

# Shared secret protecting /api/cron. Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Base URL of the deployed app (used for OAuth redirects locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
